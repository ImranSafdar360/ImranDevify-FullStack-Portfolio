# Copy to .env.local and fill in. Never commit real values.

# MongoDB Atlas connection string (Atlas → Connect → Drivers).
MONGODB_URI=

# Optional, local only: DNS servers for the MongoDB driver's SRV lookup.
# Set this if `mongodb+srv://` fails with ECONNREFUSED because a local DNS service (VPN, ad blocker) blocks SRV queries.
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
